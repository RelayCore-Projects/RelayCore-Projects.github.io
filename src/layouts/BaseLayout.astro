---
// Shared frame for every page: <head>, header and footer.
// A page passes its own title and description; its content goes into <slot />.
import { getCollection } from 'astro:content';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'RelayCore Projects · Simon Richárd Tamás',
	description = 'Personal projects of Simon Richárd Tamás, software tester.',
} = Astro.props;

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			// Set the theme before the page is drawn, so it does not flash.
			(() => {
				let theme;
				try {
					theme = localStorage.getItem('theme');
				} catch {}
				if (theme !== 'light' && theme !== 'dark') {
					theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body>
		<header class="site-header">
			<div class="container">
				<div class="header-top">
					<a href="/" class="logo">
						<img
							src="/relaycore-lockup-transparent-paper.svg"
							alt="RelayCore Projects"
							width="149"
							height="56"
						/>
					</a>
					<button type="button" class="theme-toggle" aria-pressed="false">Dark mode</button>
				</div>
				<nav aria-label="Main" class="site-nav">
					<details class="dropdown">
						<summary>Projects</summary>
						<ul class="dropdown-menu">
							{
								projects.map((project) => {
									const href = `/projects/${project.id}/`;
									return (
										<li>
											<a href={href} aria-current={path === href ? 'page' : undefined}>
												{project.data.title}
											</a>
										</li>
									);
								})
							}
						</ul>
					</details>
					<a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About me</a>
				</nav>
			</div>
		</header>
		<main class="container">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="container">
				<p>© 2026 Simon Richárd Tamás · <a href="https://github.com/RelayCore-Projects">GitHub</a></p>
			</div>
		</footer>
	</body>
</html>

<script>
	// Theme toggle: switches between light and dark and remembers the choice.
	const root = document.documentElement;
	const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

	function showState() {
		toggle?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
	}

	toggle?.addEventListener('click', () => {
		root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
		try {
			localStorage.setItem('theme', root.dataset.theme);
		} catch {}
		showState();
	});
	showState();

	// Projects menu: close it on a click outside or on Escape.
	const dropdown = document.querySelector<HTMLDetailsElement>('.dropdown');

	document.addEventListener('click', (event) => {
		if (dropdown?.open && !dropdown.contains(event.target as Node)) {
			dropdown.open = false;
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && dropdown?.open) {
			dropdown.open = false;
			dropdown.querySelector('summary')?.focus();
		}
	});
</script>

<style>
	.site-header {
		background: var(--navy);
		color: var(--paper);
		border-bottom: 4px solid var(--copper);
	}

	.header-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.25rem;
	}

	.logo {
		display: block;
		line-height: 0;
	}

	.theme-toggle {
		font: inherit;
		font-size: 0.875rem;
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
		border: 1px solid var(--paper);
		background: transparent;
		color: var(--paper);
		cursor: pointer;
	}

	.theme-toggle[aria-pressed='true'] {
		background: var(--copper);
		border-color: var(--copper);
		color: var(--navy);
	}

	.site-nav {
		display: flex;
		gap: 1.75rem;
		padding: 1rem 0 0.9rem;
		font-weight: 550;
	}

	.site-nav a,
	.site-nav summary {
		color: var(--paper);
		text-decoration: none;
		cursor: pointer;
	}

	.site-nav a:hover,
	.site-nav summary:hover {
		color: var(--copper);
	}

	.site-nav a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--copper);
		text-decoration-thickness: 3px;
		text-underline-offset: 6px;
	}

	.dropdown {
		position: relative;
	}

	.dropdown summary {
		list-style: none;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.dropdown summary::-webkit-details-marker {
		display: none;
	}

	/* Small chevron drawn with two borders; turns over when the menu is open. */
	.dropdown summary::after {
		content: '';
		width: 0.45rem;
		height: 0.45rem;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: translateY(-0.15rem) rotate(45deg);
		transition: transform 0.15s;
	}

	.dropdown[open] summary::after {
		transform: translateY(0.1rem) rotate(-135deg);
	}

	.dropdown-menu {
		position: absolute;
		top: calc(100% + 0.6rem);
		left: -0.75rem;
		z-index: 10;
		min-width: 12rem;
		margin: 0;
		padding: 0.4rem;
		list-style: none;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: 0 10px 30px rgb(14 26 43 / 0.25);
	}

	.dropdown-menu a {
		display: block;
		padding: 0.5rem 0.75rem;
		border-radius: 0.35rem;
		color: var(--text);
	}

	.dropdown-menu a:hover,
	.dropdown-menu a[aria-current='page'] {
		background: var(--bg);
		color: var(--text);
		text-decoration: none;
		box-shadow: inset 3px 0 0 var(--copper);
	}

	main {
		padding-top: 3rem;
		padding-bottom: 3rem;
		min-height: 60vh;
	}

	.site-footer {
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.9rem;
	}

	.site-footer p {
		margin: 0;
		padding: 1.5rem 0;
	}

	.site-footer a {
		color: var(--muted);
	}
</style>
