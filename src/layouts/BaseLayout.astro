---
// Shared frame for every page: <head>, header and footer.
// A page passes its own title and description; its content goes into <slot />.
import { getCollection } from 'astro:content';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'RelayCore Projects · Simon Richárd Tamás',
	description = 'Personal projects of Simon Richárd Tamás, software tester.',
} = Astro.props;

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<header>
			<a href="/">
				<img
					src="/relaycore-lockup-transparent-navy.svg"
					alt="RelayCore Projects"
					width="149"
					height="56"
				/>
			</a>
			<nav aria-label="Main">
				<details>
					<summary>Projects</summary>
					<ul>
						{
							projects.map((project) => (
								<li>
									<a href={`/projects/${project.id}/`}>{project.data.title}</a>
								</li>
							))
						}
					</ul>
				</details>
				<a href="/about/">About me</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<p>© 2026 Simon Richárd Tamás · <a href="https://github.com/RelayCore-Projects">GitHub</a></p>
		</footer>
	</body>
</html>

<style>
	body {
		max-width: 48rem;
		margin: 0 auto;
		padding: 1rem;
		font-family: system-ui, sans-serif;
		line-height: 1.6;
	}

	nav {
		display: flex;
		gap: 1.5rem;
	}
</style>
