---
// Template for a project page. The text comes from src/content/projects/<project>/<lang>.md.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
	project: CollectionEntry<'projects'>;
	lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(project);
const { title, summary, status, repo, download, tech } = project.data;
---

<BaseLayout lang={lang} title={`${title} · RelayCore Projects`} description={summary}>
	<h1>{title}</h1>
	<p class="status">{status}</p>
	<p class="lead">{summary}</p>
	<div class="actions">
		<a class="button button-primary" href={download}>{t('project.download')}</a>
		<a class="button" href={repo}>{t('project.source')}</a>
	</div>
	<div class="content">
		<Content />
	</div>
	<h2>{t('project.tech')}</h2>
	<ul class="tags">
		{tech.map((item) => <li>{item}</li>)}
	</ul>
</BaseLayout>

<style>
	.status {
		display: inline-block;
		margin: 0 0 1.25rem;
		padding: 0.2rem 0.75rem;
		border: 1px solid var(--copper);
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 600;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.75rem 0 1rem;
	}

	/* The Markdown body is rendered outside this component, hence :global(). */
	.content :global(li) {
		margin-bottom: 0.4rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 0.2rem 0.7rem;
		border-radius: 0.35rem;
		background: var(--surface);
		border: 1px solid var(--border);
		font-size: 0.9rem;
	}
</style>
